# Stoix connects to a local Hermes API through its server-side BFF.
# Copy this file to apps/web/.env.local for source development only.
# Never commit .env.local or real credentials.

HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_UI_ENABLE_REAL_HERMES=true

# Optional Hermes dashboard overrides. Leave empty to use the runtime defaults.
HERMES_DASHBOARD_BASE_URL=
HERMES_DASHBOARD_SESSION_TOKEN=

# Optional HTTPS update-manifest override. Public stable updates use the
# finxray/hermes-ui GitHub Releases channel without configuration.
# HERMES_UI_UPDATE_MANIFEST_URL=https://example.com/stoix/{channel}.json
