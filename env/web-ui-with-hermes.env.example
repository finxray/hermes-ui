# Stoix UI connected to a local Hermes runtime.
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_UI_ENABLE_REAL_HERMES=true

# Optional Hermes dashboard overrides.
HERMES_DASHBOARD_BASE_URL=
HERMES_DASHBOARD_SESSION_TOKEN=

# Optional HTTPS update-manifest override.
# HERMES_UI_UPDATE_MANIFEST_URL=https://example.com/stoix/{channel}.json
